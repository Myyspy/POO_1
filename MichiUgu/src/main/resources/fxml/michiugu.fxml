<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.michiugu.control.MichiUguControl">
   <children>
      <VBox spacing="10" alignment="TOP_CENTER" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">
         <children>

            <HBox spacing="10" alignment="CENTER">
               <children>
                  <Label text="Jugador 1:" />
                  <TextField fx:id="txtJugador1" promptText="Nombre del Jugador 1" />
                  <Label text="Jugador 2:" />
                  <TextField fx:id="txtJugador2" promptText="Nombre del Jugador 2" />
                  <Label text="Partida:" />
                  <TextField fx:id="txtNombrePartida" promptText="Nombre de la Partida" />
               </children>
            </HBox>


            <HBox spacing="10" alignment="CENTER">
               <children>
                  <Button fx:id="btnIniciar" text="Iniciar" onAction="#iniciarPartida" />
                  <Button fx:id="btnAnular" text="Anular" onAction="#anularPartida" disable="true" />
               </children>
            </HBox>


            <HBox spacing="20" alignment="CENTER">
               <children>


                  <GridPane fx:id="gridTablero" hgap="5" vgap="5">
                     <padding><Insets top="10" left="10" right="10" bottom="10"/></padding>
                     <children>

                        <Button fx:id="btn0_0" GridPane.rowIndex="0" GridPane.columnIndex="0" minWidth="50" minHeight="50"/>
                        <Button fx:id="btn0_1" GridPane.rowIndex="0" GridPane.columnIndex="1" minWidth="50" minHeight="50"/>
                        <Button fx:id="btn0_2" GridPane.rowIndex="0" GridPane.columnIndex="2" minWidth="50" minHeight="50"/>


                        <Button fx:id="btn1_0" GridPane.rowIndex="1" GridPane.columnIndex="0" minWidth="50" minHeight="50"/>
                        <Button fx:id="btn1_1" GridPane.rowIndex="1" GridPane.columnIndex="1" minWidth="50" minHeight="50"/>
                        <Button fx:id="btn1_2" GridPane.rowIndex="1" GridPane.columnIndex="2" minWidth="50" minHeight="50"/>


                        <Button fx:id="btn2_0" GridPane.rowIndex="2" GridPane.columnIndex="0" minWidth="50" minHeight="50"/>
                        <Button fx:id="btn2_1" GridPane.rowIndex="2" GridPane.columnIndex="1" minWidth="50" minHeight="50"/>
                        <Button fx:id="btn2_2" GridPane.rowIndex="2" GridPane.columnIndex="2" minWidth="50" minHeight="50"/>
                     </children>
                  </GridPane>


                  <VBox spacing="10">
                     <children>
                        <Label text="Jugador 1:" />
                        <Label fx:id="lblJugador1" text="-" />
                        <Label text="Jugador 2:" />
                        <Label fx:id="lblJugador2" text="-" />
                        <Label text="Turno actual:" />
                        <Label fx:id="lblTurno" text="Esperando..." style="-fx-font-weight: bold" />
                     </children>
                  </VBox>

               </children>
            </HBox>


            <TableView fx:id="tablaPuntajes" prefHeight="200">
               <columns>
                  <TableColumn fx:id="colNumero" text="N°" prefWidth="50"/>
                  <TableColumn fx:id="colPartida" text="Partida" prefWidth="100"/>
                  <TableColumn fx:id="colJugador1" text="Jugador 1" prefWidth="100"/>
                  <TableColumn fx:id="colJugador2" text="Jugador 2" prefWidth="100"/>
                  <TableColumn fx:id="colGanador" text="Ganador" prefWidth="100"/>
                  <TableColumn fx:id="colPunto" text="Punto" prefWidth="70"/>
                  <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
               </columns>
            </TableView>

         </children>
      </VBox>
   </children>
</AnchorPane>
